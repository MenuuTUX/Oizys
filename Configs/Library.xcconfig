#include "Base.xcconfig"

// The dynamic library exists so the Python suite can drive the encoder and the protocol
// code directly through ctypes. It exports everything: hiding symbols here would only
// hide them from the tests.
GCC_SYMBOLS_PRIVATE_EXTERN = NO
GCC_OPTIMIZATION_LEVEL = 2
OTHER_CFLAGS = $(OIZYS_CPU)
DYLIB_INSTALL_NAME_BASE = @rpath
EXECUTABLE_PREFIX = lib
