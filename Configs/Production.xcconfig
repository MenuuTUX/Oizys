#include "Release.xcconfig"
// Optimized even with diagnostics: -O0 changes timing-sensitive USB behavior.
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) OIZYS_DIAGNOSTICS=0 OIZYS_VERBOSE=0 OIZYS_ALLOW_DISPLAYLINK=0
SWIFT_ACTIVE_COMPILATION_CONDITIONS = OIZYS_PRODUCTION
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
